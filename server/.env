# Configuración del Servidor y Base de Datos - Control de Vacaciones Grupo JAMA
PORT=5000
NODE_ENV=development

# Conexión a Microsoft SQL Server (Instancia Local u On-Premise)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ControlVacaciones_DO
DB_USER=sa
DB_PASSWORD=TuPasswordSeguro123!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=5000
DB_REQUEST_TIMEOUT=15000

# Base de datos fuente CONTPAQi Nóminas (NOMIPAQ)
NOMIPAQ_DB=nomipaq_jama

# Clave secreta para tokens JWT y sesiones
JWT_SECRET=jama_secret_vacaciones_do_2026_jwt_token

# Fallback automático: Si SQL Server aún no está inicializado o levantado,
# utilizar el almacén en memoria con los 601 colaboradores de Grupo JAMA para pruebas inmediatas
USE_MOCK_FALLBACK=true
