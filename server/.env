# Configuración del Servidor y Bases de Datos - DESARROLLO_O
PORT=5001
NODE_ENV=development

# 1. Base de Datos Local de la Aplicación: DESARROLLO_O
LOCAL_DB_SERVER=192.168.20.15
LOCAL_DB_PORT=1433
LOCAL_DB_NAME=DESARROLLO_O
LOCAL_DB_USER=sa
LOCAL_DB_PASSWORD=Grupojama1
LOCAL_DB_ENCRYPT=false
LOCAL_DB_TRUST_SERVER_CERTIFICATE=true
LOCAL_DB_CONNECTION_TIMEOUT=5000
LOCAL_DB_REQUEST_TIMEOUT=15000

# 2. Servidor Remoto CONTPAQi Nóminas
NOMIPAQ_REMOTE_SERVER=192.168.20.29
NOMIPAQ_REMOTE_PORT=51700
NOMIPAQ_REMOTE_INSTANCE=COMPAC
NOMIPAQ_REMOTE_USER=SA
NOMIPAQ_REMOTE_PASSWORD=Jama24
NOMIPAQ_REMOTE_ENCRYPT=false
NOMIPAQ_REMOTE_TRUST_SERVER_CERTIFICATE=true
NOMIPAQ_REMOTE_CONNECTION_TIMEOUT=7000
NOMIPAQ_REMOTE_REQUEST_TIMEOUT=10000

# Lista de las 8 bases de datos de Grupo JAMA en Nóminas
NOMIPAQ_DATABASES=ctCEMENTOS_MOCTEZ,ctCONSTRUJAMA_DE_,ctCONTROLADORA_JA,ctDISTRIBUIDOR_DE,ctDISTRIBUIDORA_J,ctIMPULSORA_DE_NE,ctLATINO_CONCRETO,ctTRAMO_DEL_CENTR

# Clave secreta JWT
JWT_SECRET=jama_secret_vacaciones_desarrollo_o_2026_jwt_token

# Fallback automático: Activa el motor local si SQL Server no está disponible
USE_MOCK_FALLBACK=true

# 4. Configuración SMTP para Notificaciones Exclusivas por Correo Electrónico
SMTP_HOST=smtp.gmail.com
